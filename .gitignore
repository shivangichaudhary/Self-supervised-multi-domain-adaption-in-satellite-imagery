# Trained checkpoints and generated visualizations (regenerable via main.py).
# Wildcarded so alternate output dirs (e.g. outputs_pastis_fixed/ from a custom
# --config output_dir override) are covered too, not just the literal "outputs/".
outputs*/*.pth
outputs*/visualizations/
outputs*/*.png

# Exception: published Objective 1 and 2 results (encoder, generator, discriminator, figures)
!outputs_pastis_fixed/
!outputs_pastis_fixed/domain_encoder.pth
!outputs_pastis_fixed/generator.pth
!outputs_pastis_fixed/discriminator.pth
!outputs_pastis_fixed/visualizations/
outputs_pastis_fixed/visualizations/segmentation_eval_*.png

